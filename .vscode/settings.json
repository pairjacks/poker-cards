{
	"files.watcherExclude": {
		"**/node_modules": true,
		"**/dist/": true
	},
	"search.exclude": {
		"**/node_modules": true,
		"**/dist/": true
	},

	"js/ts.experimental.useTsgo": true,
	"oxc.enable": true,

	"editor.formatOnSave": true,
	"editor.defaultFormatter": "oxc.oxc-vscode",
	"editor.codeActionsOnSave": { "source.fixAll.oxc": "always" }
}
